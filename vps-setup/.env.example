# ═══════════════════════════════════════════════════════════════════════════════
# Nexus Trade OS — VPS Ortam Değişkenleri
# Kopyala: cp .env.example .env  →  nano .env
# ═══════════════════════════════════════════════════════════════════════════════

# ── Domain ───────────────────────────────────────────────────────────────────
VPS_DOMAIN=your-domain.com

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_MIN32CHARS

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASS

# ── JWT / Session Secret (min 32 karakter, rastgele üret) ────────────────────
# Üretmek için: openssl rand -hex 32
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET_MIN32CHARS_RANDOM

# ── Trade Modu ───────────────────────────────────────────────────────────────
# paper  → Gerçek para yok, simülasyon (BAŞLANGIÇ İÇİN ÖNERİLİR)
# live   → Gerçek para işlem görür — DİKKATLİ OLUN!
TRADE_MODE=paper

# ── OKX API ──────────────────────────────────────────────────────────────────
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# ── Binance API ───────────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_SECRET=

# ── Bybit API ─────────────────────────────────────────────────────────────────
BYBIT_API_KEY=
BYBIT_SECRET=

# ── LLM API Anahtarları ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=
OPENAI_API_KEY=sk-...

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Bot oluşturmak için: @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
