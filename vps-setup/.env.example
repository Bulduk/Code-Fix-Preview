# ============================================================
# Nexus Trade OS — Environment Configuration
# Copy to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_MIN32CHARS

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET_MIN32CHARS
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_THIS_ENCRYPTION_KEY_EXACTLY_32CHARS

# ── Binance Futures (PRIMARY EXCHANGE) ───────────────────────────────────────
# Get from: https://www.binance.com/en/my/settings/api-management
# Required permissions: Futures Trading, Read Info
BINANCE_API_KEY=your_binance_futures_api_key
BINANCE_SECRET=your_binance_futures_secret
# Set to true to use Binance Testnet (https://testnet.binancefuture.com)
BINANCE_TESTNET=false

# ── LLM Providers (at least one required for AI features) ────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-...

# ── Telegram Bot (optional — for trade approvals & notifications) ─────────────
# Create bot: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Trade Mode ───────────────────────────────────────────────────────────────
# paper  = simulated trading (safe, default)
# live   = real money trading (CAUTION!)
TRADE_MODE=paper

# ── Domain & SSL ─────────────────────────────────────────────────────────────
VPS_DOMAIN=your-domain.com

# ── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change_this_grafana_password

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your domain in production
CORS_ORIGIN=*
