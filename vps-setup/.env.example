# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASS

# ── Borsa API Anahtarları (YALNIZCA VPS'te, asla frontend'e gönderilmez) ────
OKX_API_KEY=your_okx_api_key
OKX_SECRET=your_okx_secret
OKX_PASSPHRASE=your_okx_passphrase

BINANCE_API_KEY=your_binance_key
BINANCE_SECRET=your_binance_secret

BYBIT_API_KEY=your_bybit_key
BYBIT_SECRET=your_bybit_secret

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
OPENAI_API_KEY=sk-...

# ── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# ── Trade Modu: paper | live ──────────────────────────────────────────────────
# UYARI: live modda gerçek para işlem görür. Önce paper test edin.
TRADE_MODE=paper

# ── Replit API Server URL (Nautilus → Replit WebSocket için) ─────────────────
REPLIT_API_URL=https://YOUR_REPLIT_APP.replit.app/api
REPLIT_WS_URL=wss://YOUR_REPLIT_APP.replit.app/ws

# ── Hostinger VPS ────────────────────────────────────────────────────────────
VPS_DOMAIN=your-domain.com
